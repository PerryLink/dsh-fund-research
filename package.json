{
  "name": "dsh-fund-research",
  "version": "0.4.3",
  "description": "Research plugin for Chinese public mutual funds on DeepSeek Harness: collects fund data from public sources (Tiantian Fund / Eastmoney), computes deterministic metrics (manager profile, holdings penetration, style attribution, performance decomposition), and seals versioned Markdown research reports whose every key number traces back to a hashed source snapshot. Research only 閳?no trading, no investment advice.",
  "author": "dsh-fund-research contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryLink/dsh-fund-research.git"
  },
  "homepage": "https://github.com/PerryLink/dsh-fund-research#readme",
  "bugs": {
    "url": "https://github.com/PerryLink/dsh-fund-research/issues"
  },
  "private": false,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "skills",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "README.zh.md",
    "README.es.md",
    "README.pt.md",
    "README.hi.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshWorkshop": {
    "schema": "omdsh-workshop-package/v1",
    "type": "plugin",
    "integration": {
      "protocol": "harness-profile",
      "artifact": "cordis.patch.yml"
    },
    "install": {
      "mode": "transactional",
      "adapter": "profile-bundle",
      "failurePolicy": "generation-rollback",
      "touchesCurrentBeforeActivation": false
    },
    "lifecycle": {
      "activation": "restart-profile",
      "dispose": "supported"
    },
    "permissions": [
      "fs:read",
      "fs:write",
      "session:append",
      "storage:write",
      "network:outbound",
      "native-code:none"
    ],
    "compatibility": {
      "dshVersions": [
        "0.1.2-rc.1"
      ]
    },
    "capability": {
      "id": "fund-research",
      "kind": "tool",
      "invocation": "fund_research",
      "expected": "seals a versioned Markdown research report whose per-number traceability appendix verifies against the source snapshot"
    },
    "evidence": {
      "install": null,
      "failureIsolation": null,
      "hotReload": null,
      "remove": null
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "fund-research",
    "mutual-fund",
    "investment-research",
    "finance",
    "research-report"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-skill-filesystem": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-storage": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-storage-json": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-skill-filesystem": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage-json": {
      "optional": true
    }
  },
  "dependencies": {
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-attachment": "0.1.2-rc.1",
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/cordis-plugin-include": "^1.0.7",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.3",
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-jobs": "0.1.2-rc.1",
    "@deepseek-ai/dsh-jobs-local": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-skill": "0.1.2-rc.1",
    "@deepseek-ai/dsh-skill-filesystem": "0.1.2-rc.1",
    "@deepseek-ai/dsh-storage": "0.1.2-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.1.2-rc.1",
    "@deepseek-ai/dsh-storage-json": "0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "^3.2.0",
    "oxlint": "0.18.1",
    "vitest": "^3.2.0",
    "zod": "^4.4.3"
  },
  "scripts": {
    "build": "node scripts/prepare.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "typecheck:ci": "tsc -p tsconfig.ci.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run test/e2e.live.spec.ts",
    "lint": "oxlint",
    "prepare": "node scripts/prepare.mjs",
    "verify:self-contained": "node scripts/verify-self-contained.mjs",
    "verify:artifacts": "node scripts/verify-artifacts.mjs",
    "verify:readme-sync": "node scripts/check-readme-sync.mjs",
    "pack:check": "node scripts/prepare.mjs && pnpm pack"
  },
  "license": "Apache-2.0",
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/PerryLink"
  }
}
